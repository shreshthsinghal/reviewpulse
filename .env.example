# ReviewPulse env vars (see README.md for full details)
#
# Required for the full pipeline (classification, note generation, email
# drafting). Without these, the Groww default flow falls back to the bundled
# sample dataset, and the alternate-app flow returns a clear error.
#
# All four fields below come from a single .z-ai-config file you can get
# from your Z.ai account or your dev environment. The minimum is GLM_API_KEY
# + GLM_BASE_URL; the other three (chatId, userId, token) are needed if your
# endpoint uses them for auth (the Z.ai internal endpoint does).

GLM_API_KEY=your-api-key
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_CHAT_ID=
GLM_USER_ID=
GLM_TOKEN=

# Optional -- only needed if the "Send" button in the Email view should actually send
EMAIL_API_KEY=your-resend-key-here
EMAIL_FROM=ReviewPulse <you@yourdomain.com>
